    { "source": "/s/:key", "destination": "/api/share?kind=s&key=:key" },
    { "source": "/r/:key/card.png", "destination": "/api/share?kind=r&key=:key&as=png" },
    { "source": "/r/:key", "destination": "/api/share?kind=r&key=:key" }
  ]
}
