# The leaderboard API's settings (api/_lib/config.js explains each). For `vercel dev`, copy this
# to .env (vercel dev reads .env, not .env.local) and fill it with the Neon *dev* branch; the API
# refuses to start if a non-production environment points at the production branch.
DATABASE_URL=postgresql://sc_app:<password>@<dev-branch-host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
IP_HASH_SECRET=<openssl rand -base64 48>
NEON_PROD_HOST=<prod-branch-host>.<region>.aws.neon.tech
# Optional: the top-ten alert email (Resend, sending-only key)
RESEND_API_KEY=
NOTIFY_EMAIL=
